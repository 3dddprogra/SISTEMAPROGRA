# =====================================================================
# FOODTECH: Configuración Compartida de Infraestructura y Despliegue
# UNICEN - Cochabamba | Red Privada VirtualBox Host-Only
# =====================================================================

# 1. Direcciones IP de las Máquinas Virtuales (Adaptador Solo-Anfitrión 192.168.56.0/24)
VM_DB_IP=192.168.56.10
VM_BACKEND_IP=192.168.56.11
VM_FRONTEND_IP=192.168.56.12

# 2. Configuración de Base de Datos MySQL 8.x
DB_HOST=192.168.56.10
DB_PORT=3306
DB_NAME=unicen_app
DB_USER=foodtech_user
DB_PASSWORD=CAMBIAR_ESTO
DB_ROOT_PASSWORD=CAMBIAR_ESTO

# 3. Autenticación y Seguridad JWT
JWT_SECRET=CAMBIAR_ESTO
JWT_EXPIRES_IN=12h

# 4. Puertos y Ambientes de Ejecución
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=80
NODE_ENV=production
CORS_ORIGIN=*

# 5. Dominio / Host Base
CLIENT_URL=http://192.168.56.12
API_BASE_URL=http://192.168.56.11:3000/api/v1
